<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐼 熊猫侠车载启动器"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="悬浮窗插件系统"
        android:textColor="#90EE90"
        android:textSize="18sp"
        android:layout_marginBottom="24dp"/>

    <!-- 音乐悬浮窗按钮 -->
    <Button
        android:id="@+id/btn_music_float"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🎵 音乐悬浮窗"
        android:backgroundTint="#E91E63"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <!-- 地图悬浮窗按钮 -->
    <Button
        android:id="@+id/btn_map_float"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🗺️ 地图悬浮窗"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <!-- 天气悬浮窗按钮 -->
    <Button
        android:id="@+id/btn_weather_float"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🌤️ 天气悬浮窗"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="24dp"/>

    <!-- 批量操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_show_all"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="显示全部"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_hide_all"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="隐藏全部"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"/>

    <!-- 权限设置按钮 -->
    <Button
        android:id="@+id/btn_permission"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="⚙️ 悬浮窗权限设置"
        android:backgroundTint="#607D8B"
        android:textColor="#FFFFFF"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="提示：首次使用需要开启悬浮窗权限"
        android:textColor="#999999"
        android:textSize="12sp"
        android:layout_marginTop="16dp"/>

</LinearLayout>
